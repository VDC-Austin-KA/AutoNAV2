<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>LevelTest</RootNamespace>
    <AssemblyName>leveltest</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NWPackageVersion Condition="'$(NWPackageVersion)' == ''">2025.0.0</NWPackageVersion>
    <NWYear>$(NWPackageVersion.Substring(0, 4))</NWYear>
    <DefineConstants>$(DefineConstants);NW$(NWYear)</DefineConstants>
    <NoWarn>$(NoWarn);CS0649;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../typecheck/obj/MainWindow.g.cs" />
    <Compile Include="../../AutoNAV/**/*.cs" Exclude="../../AutoNAV/obj/**/*.cs;../../AutoNAV/bin/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Speckle.Navisworks.API" Version="$(NWPackageVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
