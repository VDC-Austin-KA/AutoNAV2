<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{12345678-1234-1234-1234-123456789012}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>AutoNAV</RootNamespace>
    <AssemblyName>AutoNAV</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <!-- Debug x64 -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <!-- Release x64 -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <!-- Auto-detect Navisworks installation: prefers newest available (2027 → 2024) -->
  <PropertyGroup>
    <NWPath Condition="Exists('C:\Program Files\Autodesk\Navisworks Manage 2027\Autodesk.Navisworks.Api.dll')">C:\Program Files\Autodesk\Navisworks Manage 2027\</NWPath>
    <NWPath Condition="'$(NWPath)' == '' AND Exists('C:\Program Files\Autodesk\Navisworks Manage 2026\Autodesk.Navisworks.Api.dll')">C:\Program Files\Autodesk\Navisworks Manage 2026\</NWPath>
    <NWPath Condition="'$(NWPath)' == '' AND Exists('C:\Program Files\Autodesk\Navisworks Manage 2025\Autodesk.Navisworks.Api.dll')">C:\Program Files\Autodesk\Navisworks Manage 2025\</NWPath>
    <NWPath Condition="'$(NWPath)' == '' AND Exists('C:\Program Files\Autodesk\Navisworks Manage 2024\Autodesk.Navisworks.Api.dll')">C:\Program Files\Autodesk\Navisworks Manage 2024\</NWPath>
    <NWPath Condition="'$(NWPath)' == ''">C:\Program Files\Autodesk\Navisworks Manage 2025\</NWPath>
  </PropertyGroup>
  <!-- References -->
  <ItemGroup>
    <!-- .NET Framework References -->
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
    <!-- WPF References -->
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <!-- Windows Forms -->
    <Reference Include="System.Windows.Forms" />
    <!-- Navisworks References (2025 preferred, falls back to 2024) -->
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NWPath)Autodesk.Navisworks.Api.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Clash">
      <HintPath>$(NWPath)Autodesk.Navisworks.Clash.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.ComApi">
      <HintPath>$(NWPath)Autodesk.Navisworks.ComApi.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Interop.ComApi">
      <HintPath>$(NWPath)Autodesk.Navisworks.Interop.ComApi.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <!-- Source Files -->
  <ItemGroup>
    <Compile Include="PluginMain.cs" />
    <Compile Include="MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="obj\x64\Release\MainWindow.g.cs" />
    <Compile Include="SearchSetGenerator.cs" />
    <Compile Include="ClashTestGeneratorEngine.cs" />
    <Compile Include="ClashResultGrouper.cs" />
    <Compile Include="ClashGrouper.cs" />
  </ItemGroup>
  <!-- XAML Pages -->
  <ItemGroup>
    <Page Include="MainWindow.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <!-- Other Files -->
  <ItemGroup>
    <None Include="AutoNAV.addin" />
    <None Include="BUG_FIX_MULTIPLE_DISCIPLINES.md" />
    <None Include="CHANGELOG_V2.md" />
    <None Include="DISTRIBUTION_COMPLETE_GUIDE.md" />
    <None Include="FINAL_SOLUTION_SUMMARY.md" />
    <None Include="FINAL_SUMMARY_DISTRIBUTION_READY.md" />
    <None Include="FUNCTION4_IMPLEMENTATION.md" />
    <None Include="IMPLEMENTATION_SUMMARY.md" />
    <None Include="INSTALLATION_AND_DISTRIBUTION_GUIDE.md" />
    <None Include="INSTALLATION_GUIDE.md" />
    <None Include="InstallAutoNAV.bat" />
    <None Include="InstallAutoNAV.ps1" />
    <None Include="PackageContents.xml" />
    <None Include="PER_DISCIPLINE_SELECTION_GUIDE.md" />
    <None Include="QUICK_REFERENCE_CARD.md" />
    <None Include="README_IMPLEMENTATION.md" />
    <None Include="READY_FOR_DISTRIBUTION.md" />
    <None Include="SMART_FOLDER_REBUILD_GUIDE.md" />
    <None Include="UI_IMPROVEMENTS_SUMMARY.md" />
    <None Include="UI_VISUAL_GUIDE.md" />
  </ItemGroup>
  <!-- Import Common Targets -->
  <ItemGroup>
    <Content Include="COMPLETION_SUMMARY.txt" />
    <Content Include="DEPLOYMENT_SUMMARY.txt" />
    <Content Include="DISTRIBUTION_CHECKLIST.txt" />
    <Content Include="MANIFEST.xml" />
    <Content Include="README.txt" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- WPF XAML Compilation -->
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.WinFX.targets" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.WinFX.targets')" />
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\PresentationBuildTasks.targets" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\PresentationBuildTasks.targets')" />
</Project>