<Window x:Class="AutoNAV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoNAV"
        Height="780"
        Width="1080"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- ===== Colours ===== -->
        <SolidColorBrush x:Key="Primary"        Color="#0078D4"/>
        <SolidColorBrush x:Key="PrimaryDark"    Color="#005A9E"/>
        <SolidColorBrush x:Key="PrimaryLight"   Color="#DEEBFF"/>
        <SolidColorBrush x:Key="Surface"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceAlt"     Color="#FAFBFC"/>
        <SolidColorBrush x:Key="Border"         Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BorderStrong"   Color="#CBD5E0"/>
        <SolidColorBrush x:Key="TextPrimary"    Color="#1A202C"/>
        <SolidColorBrush x:Key="TextSecondary"  Color="#4A5568"/>
        <SolidColorBrush x:Key="TextMuted"      Color="#718096"/>
        <SolidColorBrush x:Key="Success"        Color="#00875A"/>
        <SolidColorBrush x:Key="Warning"        Color="#D9822B"/>
        <SolidColorBrush x:Key="Danger"         Color="#DE350B"/>
        <SolidColorBrush x:Key="Accent"         Color="#5C2D91"/>

        <!-- ===== Card container ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="CardSubtle" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- ===== Typography ===== -->
        <Style x:Key="TabTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="TabIntro" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="CardSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="CardBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>

        <!-- ===== Buttons ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Primary}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MutedButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F0F2F5"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource Success}"/>
        </Style>
        <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource Warning}"/>
        </Style>

        <!-- ===== Input controls ===== -->
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>

        <!-- ===== Tab headers ===== -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                  HorizontalAlignment="Center" RecognizesAccessKey="True"/>
                                <Border x:Name="indicator" VerticalAlignment="Bottom" Height="3"
                                        Background="Transparent" Margin="6,0,6,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                                <Setter TargetName="indicator" Property="Background" Value="{StaticResource Primary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== "More info" expander ===== -->
        <Style x:Key="InfoExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
            <Setter Property="Header" Value="ⓘ  How does this work?"/>
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="LineHeight" Value="17"/>
                    <Setter Property="Margin" Value="0,4,0,6"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- ===== Status pills ===== -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimaryLight}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True" Background="{StaticResource Surface}">

        <!-- ===== HEADER ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="24,18,24,16" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPill}">
                        <TextBlock Text="v3.8 · NW 2024–2027" FontSize="11" Foreground="{StaticResource Primary}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="AutoNAV" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Automated Design Coordination for Navisworks Manage" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== STATUS PANEL (bottom) ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="20,10" MinHeight="78">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Vertical" VerticalAlignment="Top" Margin="14,0,0,0">
                    <Button Name="btnStatusClear" Content="Clear" Click="OnStatusClearClick"
                            Style="{StaticResource MutedButton}" Padding="10,4" MinHeight="0" FontSize="11"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Activity" FontSize="10" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Name="txtStatus" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <ScrollViewer Name="svAppStatus" VerticalScrollBarVisibility="Auto" MaxHeight="100">
                    <TextBlock Name="txtAppStatus" FontSize="11" TextWrapping="Wrap" Padding="2,0"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== MAIN TAB CONTROL ===== -->
        <TabControl Margin="20,16,20,12" Background="Transparent" BorderThickness="0"
                    ItemContainerStyle="{StaticResource ModernTabItem}">
            <TabControl.Resources>
                <Style TargetType="TabPanel">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </TabControl.Resources>

            <!-- =============================================================
                 TAB 1: HOME
                 ============================================================= -->
            <TabItem Header="Home">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,4,4">
                    <Grid MaxWidth="900" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource TabTitle}" Text="Welcome to AutoNAV"/>
                            <TextBlock Style="{StaticResource TabIntro}">
                                AutoNAV automates the most repetitive parts of clash coordination in Navisworks
                                Manage — building search sets per discipline, generating clash test pairs,
                                running them, grouping the results by where they sit in the building, and
                                naming each group consistently. Pick a tab above to do one step at a time, or
                                run AutoNAVismate below to do it all in one click.
                            </TextBlock>
                        </StackPanel>

                        <!-- Quick start card -->
                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource CardSubtitle}" Text="QUICK START"/>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="AutoNAVismate — one-button workflow"/>
                                    <TextBlock Style="{StaticResource CardBody}">
                                        Runs every AutoNAV step in sequence with sensible defaults.
                                        You'll only be prompted when AutoNAV can't determine something on its own
                                        (e.g. an unknown discipline for a loaded model).
                                    </TextBlock>
                                    <Expander Style="{StaticResource InfoExpander}">
                                        <StackPanel>
                                            <TextBlock>
                                                <Run FontWeight="SemiBold">What it does, step by step:</Run>
                                            </TextBlock>
                                            <TextBlock>1.  Function 1 — discipline search sets from the loaded model filenames.</TextBlock>
                                            <TextBlock>2.  Function 2 — element-property search sets, using each discipline's default property.</TextBlock>
                                            <TextBlock>3.  Function 4 — generate every cross-discipline clash test pair and auto-run them.</TextBlock>
                                            <TextBlock>4.  Function 5 — group Walls / Floors across every clash test.</TextBlock>
                                            <TextBlock>5.  Function 6 — group remaining clashes by proximity, name with the default template.</TextBlock>
                                            <TextBlock Margin="0,8,0,0">
                                                <Run FontWeight="SemiBold">When to use it:</Run> Brand new model that you're coordinating for the first time, or any time you want a clean baseline before manual review.
                                            </TextBlock>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                                <Button Grid.Column="1" Name="btnAutoNAVismate" Content="Run AutoNAVismate"
                                        Click="OnAutoNAVismateClick" Style="{StaticResource PrimaryButton}"
                                        VerticalAlignment="Center" MinWidth="180" Padding="22,12" FontSize="13"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,138,0,16" Background="Transparent" BorderThickness="0" Padding="0">
                            <TextBlock Name="txtAutoNAVismateProgress" Style="{StaticResource Hint}" Margin="20,0,20,0"/>
                        </Border>

                        <!-- Workflow overview -->
                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardSubtitle}" Text="MANUAL WORKFLOW"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Step by step"/>
                                <TextBlock Style="{StaticResource CardBody}">
                                    If you'd rather drive each step yourself, the tabs above are organised in the
                                    order you'd typically use them.
                                </TextBlock>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource CardSubtle}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Primary}" Text="1. SETUP"/>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="Search Sets" Margin="0,4,0,4"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Text="Build discipline + element search sets that the rest of the workflow depends on."/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource CardSubtle}" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Primary}" Text="2. RUN"/>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="Clash Tests" Margin="0,4,0,4"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Text="Generate every cross-discipline clash test pair and run them in one click."/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource CardSubtle}" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Primary}" Text="3. GROUP"/>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="Group &amp; Name" Margin="0,4,0,4"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Text="Cluster clashes by proximity, walls/floors, or your own grouping mode."/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource CardSubtle}" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Primary}" Text="4. POLISH"/>
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="Rename" Margin="0,4,0,4"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Text="Apply naming templates to existing groups with a live preview."/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Tips card -->
                        <Border Grid.Row="3" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardSubtitle}" Text="TIPS"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Before you start"/>
                                <TextBlock Style="{StaticResource CardBody}" Margin="0,0,0,2">
                                    •  Make sure every model you want to coordinate is loaded in Navisworks first — Function 1 reads the model list to derive disciplines.
                                </TextBlock>
                                <TextBlock Style="{StaticResource CardBody}" Margin="0,0,0,2">
                                    •  All AutoNAV's actions are recorded in the Activity panel at the bottom of the window so you can see what it's doing.
                                </TextBlock>
                                <TextBlock Style="{StaticResource CardBody}" Margin="0,0,0,2">
                                    •  Walls and Floors clash groups (created by Function 5) are preserved by every other tool — they never get renamed or regrouped.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- =============================================================
                 TAB 2: SETUP (Search Sets)
                 ============================================================= -->
            <TabItem Header="1. Setup">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,4,4">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource TabTitle}" Text="Search Sets"/>
                        <TextBlock Style="{StaticResource TabIntro}">
                            Build the search sets that the rest of the workflow depends on. Functions 1 and 2 are the
                            most-used; Function 3 is an optional power tool for custom queries.
                        </TextBlock>

                        <!-- Function 1 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardSubtitle}" Text="FUNCTION 1"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Create discipline search sets"/>
                                <TextBlock Style="{StaticResource CardBody}">
                                    Scans every loaded model filename and creates a "1. DISCIPLINES" folder of search sets,
                                    one per discipline (ARCH, STRC, MECH, ELEC, PLBG, FP, …). Drop the matching discipline
                                    here and Function 4 can pair them up later.
                                </TextBlock>
                                <Expander Style="{StaticResource InfoExpander}">
                                    <StackPanel>
                                        <TextBlock><Run FontWeight="SemiBold">How it identifies the discipline:</Run></TextBlock>
                                        <TextBlock>•  Splits each filename on - / _ / space, then matches the resulting tokens against a built-in dictionary of NCS discipline codes.</TextBlock>
                                        <TextBlock>•  If a filename has no recognisable discipline token (e.g. <Italic>UTUSB-TPC-DW-L01.nwc</Italic>), it falls back to the shortest unique discriminator — the token that distinguishes this file from every other loaded file.</TextBlock>
                                        <TextBlock>•  Anything still unidentified pops a picker dialog where you assign a discipline by hand.</TextBlock>
                                        <TextBlock Margin="0,8,0,0"><Run FontWeight="SemiBold">Example:</Run></TextBlock>
                                        <TextBlock FontFamily="Consolas" Foreground="{StaticResource TextPrimary}">
                                            UTUSB-DSGN-ARCH-L01.nwc   →  ARCH (Architectural)
                                            UTUSB-DSGN-STRC-L01.nwc   →  STRC (Structural)
                                            UTUSB-DSGN-MECH-L01.nwc   →  MECH (Mechanical)
                                            UTUSB-DSGN-ELEC-L01.nwc   →  ELEC (Electrical)
                                        </TextBlock>
                                    </StackPanel>
                                </Expander>
                                <Button Name="btnFunction1" Content="Generate Discipline Sets"
                                        Click="OnFunction1Click" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Function 2 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardSubtitle}" Text="FUNCTION 2"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Create element-property search sets"/>
                                <TextBlock Style="{StaticResource CardBody}">
                                    For every discipline checked below, generates one search set per unique value of the
                                    chosen element property. The dropdown next to each discipline lists property types
                                    that work well for that discipline (e.g. System Abbreviation for MECH, Category for
                                    ARCH/STRC). Function 1 must be run first.
                                </TextBlock>
                                <Expander Style="{StaticResource InfoExpander}">
                                    <StackPanel>
                                        <TextBlock><Run FontWeight="SemiBold">Why discipline-specific options?</Run></TextBlock>
                                        <TextBlock>Mechanical / Plumbing / Electrical models are organised by system, so "System Abbreviation" cuts them cleanly. Architectural / Structural models are organised by category, so "Category" works better.</TextBlock>
                                        <TextBlock Margin="0,8,0,0"><Run FontWeight="SemiBold">Tip:</Run> The last option in every dropdown is "Element → File (catch-all)" which creates a single search set covering everything in that discipline's file. Pick this when the property-based option leaves elements unaccounted for.</TextBlock>
                                    </StackPanel>
                                </Expander>

                                <Border Style="{StaticResource CardSubtle}" Margin="0,8,0,12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Disciplines &amp; property type"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Name="btnSelectAllDisciplines" Content="Select All" Click="BtnSelectAll_Click" Style="{StaticResource MutedButton}" Padding="10,4" MinHeight="0" FontSize="11" Margin="0,0,6,0"/>
                                            <Button Name="btnDeselectAllDisciplines" Content="Deselect All" Click="BtnDeselectAll_Click" Style="{StaticResource MutedButton}" Padding="10,4" MinHeight="0" FontSize="11" Margin="0,0,6,0"/>
                                            <Button Name="btnInvertSelection" Content="Invert" Click="BtnInvertSelection_Click" Style="{StaticResource MutedButton}" Padding="10,4" MinHeight="0" FontSize="11" Margin="0,0,6,0"/>
                                            <Button Name="btnRefreshDisciplineList" Content="Refresh" Click="BtnRefreshDisciplines_Click" Style="{StaticResource MutedButton}" Padding="10,4" MinHeight="0" FontSize="11"/>
                                        </StackPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="120" MaxHeight="280" BorderThickness="1" BorderBrush="{StaticResource Border}" Background="White">
                                            <StackPanel Name="disciplineCheckboxPanel" Orientation="Vertical" Margin="10">
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" FontStyle="Italic" Text="No disciplines loaded — run Function 1 first."/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <Button Name="btnFunction2" Content="Generate Element-Property Search Sets"
                                        Click="OnFunction2Click" Style="{StaticResource SuccessButton}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Function 3 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardSubtitle}" Text="FUNCTION 3 · OPTIONAL"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Custom search sets from any property value"/>
                                <TextBlock Style="{StaticResource CardBody}">
                                    Power-user tool. Pick a discipline, a property category, then a specific property —
                                    AutoNAV makes one search set per unique value of that property in that discipline's
                                    model content.
                                </TextBlock>
                                <Expander Style="{StaticResource InfoExpander}">
                                    <StackPanel>
                                        <TextBlock><Run FontWeight="SemiBold">When to use:</Run> When the per-discipline defaults from Function 2 don't slice your data the way you need. For example, generating one search set per Pipe Material on the plumbing model.</TextBlock>
                                    </StackPanel>
                                </Expander>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Discipline"/>
                                <ComboBox Name="cmbFunction3Discipline" SelectionChanged="OnFunction3DisciplineChanged">
                                    <ComboBoxItem Content="-- Select Discipline --" IsSelected="True"/>
                                </ComboBox>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Property category"/>
                                <ComboBox Name="cmbFunction3PropertyCategory" SelectionChanged="OnFunction3PropertyCategoryChanged">
                                    <ComboBoxItem Content="-- Select Property Category --" IsSelected="True"/>
                                </ComboBox>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Property name"/>
                                <ComboBox Name="cmbFunction3PropertyName">
                                    <ComboBoxItem Content="-- Select Property --" IsSelected="True"/>
                                </ComboBox>

                                <Button Name="btnFunction3" Content="Generate Custom Search Sets"
                                        Click="OnFunction3Click" Style="{StaticResource SuccessButton}"
                                        HorizontalAlignment="Left" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- =============================================================
                 TAB 3: CLASH TESTS
                 ============================================================= -->
            <TabItem Header="2. Clash Tests">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,4,4">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource TabTitle}" Text="Generate &amp; Run Clash Tests"/>
                        <TextBlock Style="{StaticResource TabIntro}">
                            Function 4 generates every cross-discipline clash test pair from the search sets created in
                            Setup, then auto-runs them. Update All re-runs whatever tests already exist.
                        </TextBlock>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardSubtitle}" Text="FUNCTION 4"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Generate clash test pairs"/>
                                <TextBlock Style="{StaticResource CardBody}">
                                    Walks every pair of disciplines from "1. DISCIPLINES" (e.g. ARCH × STRC, ARCH × MECH, …)
                                    and creates a Clash Detective test for each pair. Structural and Architectural disciplines
                                    are placed on Selection A so they land on the left side of every test, matching common
                                    BIM coordination conventions.
                                </TextBlock>
                                <Expander Style="{StaticResource InfoExpander}">
                                    <StackPanel>
                                        <TextBlock><Run FontWeight="SemiBold">Ordering rules:</Run></TextBlock>
                                        <TextBlock>•  Identified Structural (highest priority on the left side)</TextBlock>
                                        <TextBlock>•  Identified Architectural</TextBlock>
                                        <TextBlock>•  Pattern-matched STRC / ARCH</TextBlock>
                                        <TextBlock>•  Everything else alphabetical</TextBlock>
                                        <TextBlock Margin="0,8,0,0"><Run FontWeight="SemiBold">Example with STRC identified:</Run> STRC vs ARCH, STRC vs ELEC, STRC vs MECH, STRC vs PLBG, ARCH vs ELEC, …</TextBlock>
                                        <TextBlock Margin="0,8,0,0"><Run FontWeight="SemiBold">Auto-run:</Run> Once tests are generated, AutoNAV automatically calls "Update All" on Clash Detective so you don't have to. If the run fails (e.g. a model isn't loaded), the rest of the workflow still works on whatever tests are present.</TextBlock>
                                    </StackPanel>
                                </Expander>
                                <Button Name="btnFunction4" Content="Generate Clash Tests"
                                        Click="OnFunction4Click" Style="{StaticResource WarnButton}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardSubtitle}" Text="UPDATE ALL"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Re-run every existing clash test"/>
                                <TextBlock Style="{StaticResource CardBody}">
                                    Runs Navisworks' "Update All" on every clash test in the document. Useful after model
                                    changes, or if Function 4's auto-run didn't pick up a recent edit.
                                </TextBlock>
                                <Button Name="btnUpdateAllTests" Content="Update All Tests"
                                        Click="OnUpdateAllTestsClick" Style="{StaticResource WarnButton}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- =============================================================
                 TAB 4: GROUP & NAME
                 ============================================================= -->
            <TabItem Header="3. Group &amp; Name">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,4,4">
                    <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource TabTitle}" Text="Group &amp; name clashes"/>
                        <TextBlock Style="{StaticResource TabIntro}">
                            Cluster clash results into named groups. Walls/Floors handles the easy-wins case first; the
                            proximity grouper sorts the rest by nearest grid intersection and names each cluster with the
                            chosen template. Use the advanced mode only when neither of those produces what you want.
                        </TextBlock>

                        <!-- Function 5 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardSubtitle}" Text="FUNCTION 5"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Group Walls &amp; Floors"/>
                                <TextBlock Style="{StaticResource CardBody}">
                                    For every clash test, collects clashes where one of the items is in a Walls or Floors
                                    search set and puts them in "Walls" or "Floors" groups respectively. Every other tool
                                    in AutoNAV preserves these two groups — they never get renamed or regrouped.
                                </TextBlock>
                                <Expander Style="{StaticResource InfoExpander}">
                                    <StackPanel>
                                        <TextBlock>This handles the most common coordination issue (penetrations / clashes against walls and floors) cleanly up front, so the rest of the grouping tools can focus on everything else.</TextBlock>
                                        <TextBlock Margin="0,8,0,0"><Run FontWeight="SemiBold">Prerequisite:</Run> Function 2 must have produced "Walls" and "Floors" search sets under the relevant discipline (typically ARCH and STRC).</TextBlock>
                                    </StackPanel>
                                </Expander>
                                <Button Name="btnFunction6" Content="Group Walls / Floors Across All Tests"
                                        Click="OnFunction6Click" Style="{StaticResource SuccessButton}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Function 6 -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardSubtitle}" Text="FUNCTION 6"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Group by proximity &amp; name with a template"/>
                                <TextBlock Style="{StaticResource CardBody}">
                                    Groups remaining clashes by their nearest grid intersection so spatially-close clashes
                                    share a cluster, then names each cluster using your selected naming template. Walls/Floors
                                    groups from Function 5 are preserved.
                                </TextBlock>
                                <Expander Style="{StaticResource InfoExpander}">
                                    <StackPanel>
                                        <TextBlock><Run FontWeight="SemiBold">Template tokens:</Run> {Month} {Day} {Year} {Level} {Area} {TestName} {SelectionA} {SelectionB} {ClashCount} {Status} {GroupIndex} {Time} {#}</TextBlock>
                                        <TextBlock Margin="0,8,0,0"><Run FontWeight="SemiBold">Example:</Run> Template <Italic>{Month}/{Day}_{Level}_{Area} | {TestName} - {SelectionA} vs {SelectionB} {#}</Italic> renders as:</TextBlock>
                                        <TextBlock FontFamily="Consolas" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,8">
                                            05/31_L03_B8:C7 | ARCH vs STRC - Railings vs Structural Framing 1
                                        </TextBlock>
                                        <TextBlock><Run FontWeight="SemiBold">Status filters:</Run> "New Clashes" controls which statuses get freshly grouped. "Regroup &amp; Rename" (only enabled when no New Clashes status is selected) re-applies the template to existing groups of those statuses.</TextBlock>
                                    </StackPanel>
                                </Expander>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Pick a clash test"/>
                                <ComboBox Name="cmbClashTest" Margin="0,0,0,4"/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Naming template"/>
                                <ComboBox Name="cmbNamingTemplate" SelectionChanged="OnNamingTemplateChanged" Margin="0,0,0,4">
                                    <ComboBoxItem Content="{}{Month}/{Day}_{Level}_{Area} | {TestName} - {SelectionA} vs {SelectionB} {#}"
                                                  Tag="{}{Month}/{Day}_{Level}_{Area} | {TestName} - {SelectionA} vs {SelectionB} {#}"
                                                  IsSelected="True"/>
                                    <ComboBoxItem Content="{}{Level}_{Area} | {TestName} - {SelectionA} vs {SelectionB} {#}"
                                                  Tag="{}{Level}_{Area} | {TestName} - {SelectionA} vs {SelectionB} {#}"/>
                                    <ComboBoxItem Content="{}{TestName} | {Level}_{Area} {#}"
                                                  Tag="{}{TestName} | {Level}_{Area} {#}"/>
                                    <ComboBoxItem Content="{}{TestName} | {Level}_ {SelectionA} vs {SelectionB} {#}"
                                                  Tag="{}{TestName} | {Level}_ {SelectionA} vs {SelectionB} {#}"/>
                                    <ComboBoxItem Content="(none — legacy auto-naming)" Tag=""/>
                                </ComboBox>
                                <TextBlock Name="txtNamingPreview" FontSize="11" Foreground="{StaticResource Primary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                <CheckBox Name="chkKeepExistingGroups" Content="Keep existing groups" IsChecked="True"/>

                                <!-- Status filters -->
                                <Border Style="{StaticResource CardSubtle}" Margin="0,8,0,12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="STATUS FILTERS"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="New Clashes — these statuses get freshly grouped &amp; named."/>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Name="chkNewStatusNew"      Content="New" IsChecked="True" Checked="OnNewStatusChanged" Unchecked="OnNewStatusChanged" Margin="0,0,16,0"/>
                                            <CheckBox Name="chkNewStatusActive"   Content="Active" Checked="OnNewStatusChanged" Unchecked="OnNewStatusChanged" Margin="0,0,16,0"/>
                                            <CheckBox Name="chkNewStatusReviewed" Content="Under Review" Checked="OnNewStatusChanged" Unchecked="OnNewStatusChanged"/>
                                        </StackPanel>
                                        <Border Name="brdRegroup" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                                            <StackPanel Name="pnlRegroup" IsEnabled="False" Opacity="0.5">
                                                <TextBlock Style="{StaticResource Hint}" Text="Regroup &amp; Rename — re-apply the template to existing groups of these statuses. Only enabled when zero New-Clashes statuses are selected above."/>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox Name="chkRegroupStatusNew"      Content="New" Margin="0,0,16,0"/>
                                                    <CheckBox Name="chkRegroupStatusActive"   Content="Active" Margin="0,0,16,0"/>
                                                    <CheckBox Name="chkRegroupStatusReviewed" Content="Under Review" Margin="0,0,16,0"/>
                                                    <CheckBox Name="chkRegroupStatusApproved" Content="Approved" Margin="0,0,16,0"/>
                                                    <CheckBox Name="chkRegroupStatusResolved" Content="Resolved"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Buttons -->
                                <WrapPanel>
                                    <Button Name="btnGroupClashes" Content="Group Selected Test" Click="OnGroupClashesClick" Style="{StaticResource AccentButton}" Margin="0,0,8,8"/>
                                    <Button Name="btnGroupAllTests" Content="Group All Tests" Click="OnGroupAllTestsClick" Style="{StaticResource AccentButton}" Margin="0,0,8,8"/>
                                    <Button Name="btnRenameSelected" Content="Rename Selected Groups" Click="OnRenameSelectedClick" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                                    <Button Name="btnUngroupClashes" Content="Ungroup (Reset)" Click="OnUngroupClashesClick" Style="{StaticResource MutedButton}" Margin="0,0,0,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Function 7 (collapsed by default) -->
                        <Expander Header="Advanced — Function 7: Manual grouping modes" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16">
                            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardBody}">
                                        Fallback grouper for when Function 6's proximity grouping isn't what you want. Pick a
                                        primary and (optional) sub-grouping mode by hand. Uses the same test selector,
                                        template, and status filters from Function 6 above.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Primary grouping mode"/>
                                    <ComboBox Name="cmbGroupingMode">
                                        <ComboBoxItem Content="None" Tag="None" IsSelected="True"/>
                                        <ComboBoxItem Content="Level" Tag="Level"/>
                                        <ComboBoxItem Content="Grid Intersection" Tag="GridIntersection"/>
                                        <ComboBoxItem Content="Selection A (First Element)" Tag="SelectionA"/>
                                        <ComboBoxItem Content="Selection B (Last Element)" Tag="SelectionB"/>
                                        <ComboBoxItem Content="Model A" Tag="ModelA"/>
                                        <ComboBoxItem Content="Model B" Tag="ModelB"/>
                                        <ComboBoxItem Content="Status" Tag="Status"/>
                                        <ComboBoxItem Content="Assigned To" Tag="AssignedTo"/>
                                        <ComboBoxItem Content="Approved By" Tag="ApprovedBy"/>
                                        <ComboBoxItem Content="File" Tag="File"/>
                                        <ComboBoxItem Content="Layer" Tag="Layer"/>
                                        <ComboBoxItem Content="First Element" Tag="First"/>
                                        <ComboBoxItem Content="Last Element" Tag="Last"/>
                                        <ComboBoxItem Content="Last Unique Pair" Tag="LastUnique"/>
                                        <ComboBoxItem Content="Walls and Floors" Tag="WallsAndFloors"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Sub-grouping mode (optional)"/>
                                    <ComboBox Name="cmbSubGroupingMode">
                                        <ComboBoxItem Content="None" Tag="None" IsSelected="True"/>
                                        <ComboBoxItem Content="Level" Tag="Level"/>
                                        <ComboBoxItem Content="Grid Intersection" Tag="GridIntersection"/>
                                        <ComboBoxItem Content="Selection A" Tag="SelectionA"/>
                                        <ComboBoxItem Content="Selection B" Tag="SelectionB"/>
                                        <ComboBoxItem Content="Model A" Tag="ModelA"/>
                                        <ComboBoxItem Content="Model B" Tag="ModelB"/>
                                        <ComboBoxItem Content="Status" Tag="Status"/>
                                        <ComboBoxItem Content="File" Tag="File"/>
                                        <ComboBoxItem Content="Layer" Tag="Layer"/>
                                        <ComboBoxItem Content="Walls and Floors" Tag="WallsAndFloors"/>
                                    </ComboBox>
                                    <WrapPanel Margin="0,16,0,0">
                                        <Button Name="btnFunction7GroupSelected" Content="Group Selected Test (Manual)" Click="OnFunction7GroupSelectedClick" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                                        <Button Name="btnFunction7GroupAll" Content="Group All Tests (Manual)" Click="OnFunction7GroupAllClick" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- =============================================================
                 TAB 5: RENAME
                 ============================================================= -->
            <TabItem Header="4. Rename">
                <DockPanel Margin="0,16,0,0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource TabTitle}" Text="Rename clash groups"/>
                        <TextBlock Style="{StaticResource TabIntro}">
                            Pick a test (or "All tests"), choose a naming template, and review the live Current → Proposed
                            mapping in the grid. Tick the rows you want renamed and click Rename Selected. Walls / Floors
                            stay untouched regardless.
                        </TextBlock>

                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Test:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold"/>
                                    <ComboBox Name="cmbRenameTest" Grid.Column="1" SelectionChanged="OnRenameTestChanged"/>
                                    <Button Grid.Column="2" Name="btnRenameRefresh" Content="Refresh" Click="OnRenameRefreshClick" Style="{StaticResource MutedButton}" Margin="8,0,0,0" Padding="14,6"/>
                                </Grid>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Preset:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold"/>
                                    <ComboBox Name="cmbRenameTemplate" Grid.Column="1" SelectionChanged="OnRenameTemplateChanged">
                                        <ComboBoxItem Content="{}{Month}/{Day}_{Level}_{Area} | {TestName} - {SelectionA} vs {SelectionB} {#}"
                                                      Tag="{}{Month}/{Day}_{Level}_{Area} | {TestName} - {SelectionA} vs {SelectionB} {#}"
                                                      IsSelected="True"/>
                                        <ComboBoxItem Content="{}{Level}_{Area} | {TestName} - {SelectionA} vs {SelectionB} {#}"
                                                      Tag="{}{Level}_{Area} | {TestName} - {SelectionA} vs {SelectionB} {#}"/>
                                        <ComboBoxItem Content="{}{TestName} | {Level}_{Area} {#}"
                                                      Tag="{}{TestName} | {Level}_{Area} {#}"/>
                                        <ComboBoxItem Content="{}{TestName} | {Level}_ {SelectionA} vs {SelectionB} {#}"
                                                      Tag="{}{TestName} | {Level}_ {SelectionA} vs {SelectionB} {#}"/>
                                        <ComboBoxItem Content="(custom — use the text box below)" Tag="__CUSTOM__"/>
                                    </ComboBox>
                                </Grid>

                                <TextBlock Style="{StaticResource Hint}" Text="Custom template (used when 'custom' preset is selected):" Margin="0,8,0,2"/>
                                <TextBox Name="txtRenameCustomTemplate"
                                         Text="{}{Month}/{Day}_{Level}_{Area} | {TestName} - {SelectionA} vs {SelectionB} {#}"
                                         TextChanged="OnRenameTemplateChanged"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Tokens: {Month} {Day} {Year} {Time} {Level} {Area} {TestName} {SelectionA} {SelectionB} {ClashCount} {Status} {GroupIndex} {#}"/>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Filter:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold"/>
                                    <ComboBox Name="cmbRenameFilter" Grid.Column="1" SelectionChanged="OnRenameFilterChanged">
                                        <ComboBoxItem Content="All groups (excl. Walls/Floors)" Tag="all" IsSelected="True"/>
                                        <ComboBoxItem Content="Groups whose current name already matches a known preset" Tag="preset"/>
                                        <ComboBoxItem Content="Groups with empty / default names only" Tag="empty"/>
                                        <ComboBoxItem Content="Include Walls / Floors (advanced)" Tag="all+wf"/>
                                    </ComboBox>
                                    <CheckBox Name="chkRenameKeepExisting" Grid.Column="2" Content="Keep existing names" IsChecked="True" Checked="OnRenameKeepExistingChanged" Unchecked="OnRenameKeepExistingChanged" Margin="14,0,0,0"/>
                                </Grid>

                                <Border Background="{StaticResource PrimaryLight}" BorderBrush="{StaticResource Primary}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
                                    <TextBlock Name="txtRenameCounts" FontSize="11" Foreground="{StaticResource PrimaryDark}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Name="btnRenameApply" Content="Rename Selected" Click="OnRenameApplyClick" Style="{StaticResource AccentButton}" MinWidth="180"/>
                        <Button Name="btnRenameSelectAll" Content="Select All Rows" Click="OnRenameSelectAllClick" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" MinWidth="140"/>
                        <Button Name="btnRenameSelectNone" Content="Clear Selection" Click="OnRenameSelectNoneClick" Style="{StaticResource MutedButton}" Margin="10,0,0,0" MinWidth="140"/>
                        <TextBlock Name="txtRenameStatus" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="11" Foreground="{StaticResource Primary}"/>
                    </StackPanel>

                    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
                        <DataGrid Name="dgRenameRows" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  SelectionMode="Extended" SelectionUnit="FullRow" Background="White"
                                  RowHeaderWidth="0" FontSize="11" AlternatingRowBackground="#FAFBFC">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Sel" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                                <DataGridTextColumn Header="Test" Binding="{Binding TestName}" Width="180" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Current Name" Binding="{Binding CurrentName}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="→" Width="20" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Proposed Name" Binding="{Binding ProposedName}" Width="*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Clashes" Binding="{Binding ClashCount}" Width="60" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
