<?xml version="1.0" encoding="utf-8"?>
<!--
  AutoNAV bundle manifest for Navisworks Manage 2024 through 2027.

  Discovery layout (per Autodesk ApplicationPlugins bundle convention):

    %APPDATA%\Autodesk\ApplicationPlugins\AutoNAV.bundle\
      PackageContents.xml                   (this file)
      Contents\
        V24\AutoNAV.dll + AutoNAV.addin     (built against Navisworks 2024 API)
        V25\AutoNAV.dll + AutoNAV.addin     (built against Navisworks 2025 API)
        V26\AutoNAV.dll + AutoNAV.addin     (built against Navisworks 2026 API)
        V27\AutoNAV.dll + AutoNAV.addin     (built against Navisworks 2027 API)

  Each Components block is gated by RuntimeRequirements/SeriesMin/SeriesMax so
  Navisworks loads only the DLL that matches the running version.
-->
<ApplicationPackage SchemaVersion="1.0"
                    ProductType="Application"
                    AutodeskProduct="Navisworks"
                    Name="AutoNAV"
                    AppVersion="3.0.0"
                    Description="AutoNAV - Automated Design Coordination for Navisworks"
                    Author="Keith Acker"
                    ProductCode="{A07C3F3B-AC11-4F7E-8B6F-AAB3CDEF1234}"
                    UpgradeCode="{B18D4E4C-BD22-5A8F-9C7D-BBCDDEEF2345}">

  <CompanyDetails Name="ACLP_VDC"
                  Url=""
                  Email="" />

  <!-- Navisworks 2024 -->
  <Components Description="AutoNAV for Navisworks Manage 2024">
    <RuntimeRequirements OS="Win64"
                        Platform="Navisworks"
                        SeriesMin="2024"
                        SeriesMax="2024" />
    <ComponentEntry AppName="AutoNAV"
                    Version="3.0.0"
                    ModuleName="./Contents/V24/AutoNAV.dll"
                    AppDescription="AutoNAV plugin for Navisworks Manage 2024" />
  </Components>

  <!-- Navisworks 2025 -->
  <Components Description="AutoNAV for Navisworks Manage 2025">
    <RuntimeRequirements OS="Win64"
                        Platform="Navisworks"
                        SeriesMin="2025"
                        SeriesMax="2025" />
    <ComponentEntry AppName="AutoNAV"
                    Version="3.0.0"
                    ModuleName="./Contents/V25/AutoNAV.dll"
                    AppDescription="AutoNAV plugin for Navisworks Manage 2025" />
  </Components>

  <!-- Navisworks 2026 -->
  <Components Description="AutoNAV for Navisworks Manage 2026">
    <RuntimeRequirements OS="Win64"
                        Platform="Navisworks"
                        SeriesMin="2026"
                        SeriesMax="2026" />
    <ComponentEntry AppName="AutoNAV"
                    Version="3.0.0"
                    ModuleName="./Contents/V26/AutoNAV.dll"
                    AppDescription="AutoNAV plugin for Navisworks Manage 2026" />
  </Components>

  <!-- Navisworks 2027 -->
  <Components Description="AutoNAV for Navisworks Manage 2027">
    <RuntimeRequirements OS="Win64"
                        Platform="Navisworks"
                        SeriesMin="2027"
                        SeriesMax="2027" />
    <ComponentEntry AppName="AutoNAV"
                    Version="3.0.0"
                    ModuleName="./Contents/V27/AutoNAV.dll"
                    AppDescription="AutoNAV plugin for Navisworks Manage 2027" />
  </Components>

</ApplicationPackage>
