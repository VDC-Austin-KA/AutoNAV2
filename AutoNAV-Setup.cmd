@echo off
:: ============================================================================
:: AutoNAV-Setup.cmd  --  single-file installer.
::
:: Bypasses every known Windows lockdown that hits .ps1 / .exe files:
::   * Removes its own Mark-of-the-Web (Zone.Identifier ADS) so SmartScreen
::     won't quarantine subsequent operations.
::   * Loads the embedded install script as a scriptblock string and pipes
::     it to PowerShell via -Command -- never uses -File, so PowerShell's
::     ExecutionPolicy (Restricted / AllSigned / Bypass / etc.) can never
::     block it.
::   * Shows visible progress at every step so a stalled run is diagnosable.
:: ============================================================================
setlocal EnableDelayedExpansion

echo.
echo  AutoNAV Setup  v3.7.0
echo  -------------------------------------------
echo  [1/5] Removing Mark-of-the-Web from self...
del "%~f0:Zone.Identifier" 2>NUL
echo        done.

REM Self-elevate if not already admin.
net session >NUL 2>&1
if errorlevel 1 (
    echo  [2/5] Requesting administrator privileges...
    powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -Verb RunAs" 2>NUL
    exit /b
)
echo  [2/5] Running with administrator privileges. OK.

set "TMPB64=%TEMP%\autonav-setup-%RANDOM%-%RANDOM%.b64"
set "TMPPS1=%TEMP%\autonav-setup-%RANDOM%-%RANDOM%.ps1"

echo  [3/5] Extracting embedded installer payload...
findstr /B "@@AUTONAV@@" "%~f0" > "!TMPB64!.raw"
if not exist "!TMPB64!.raw" (
    echo        ERROR: failed to extract payload via findstr.
    pause
    exit /b 1
)

REM Strip the @@AUTONAV@@ marker (11 chars) from each line.  We do this via a
REM PowerShell -Command (NOT -File) so ExecutionPolicy cannot block it.
powershell -NoProfile -ExecutionPolicy Bypass -Command "(Get-Content -LiteralPath '!TMPB64!.raw') | ForEach-Object { $_.Substring(11) } | Set-Content -LiteralPath '!TMPB64!'"
del "!TMPB64!.raw" >NUL 2>&1
echo        done.

echo  [4/5] Decoding base64 payload to PowerShell script...
certutil -decode "!TMPB64!" "!TMPPS1!" >NUL
if errorlevel 1 (
    echo        ERROR: certutil -decode failed.  Is the file complete?
    del "!TMPB64!" >NUL 2>&1
    pause
    exit /b 1
)
del "!TMPB64!" >NUL 2>&1
echo        done.

echo  [5/5] Running installer...
echo.
REM Invoke as a scriptblock string (not -File) so PowerShell ExecutionPolicy
REM never gets a chance to block it.  Get-Content + scriptblock.Create is the
REM canonical workaround for AllSigned / RemoteSigned environments.
powershell -NoProfile -ExecutionPolicy Bypass -Command "& ([scriptblock]::Create((Get-Content -Raw -LiteralPath '!TMPPS1!')))"
set "RC=!ERRORLEVEL!"

del "!TMPPS1!" >NUL 2>&1
echo.
echo  Setup finished (exit code !RC!).
pause
exit /b !RC!

