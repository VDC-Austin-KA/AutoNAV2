@echo off
:: AutoNAV-Setup.cmd -- single-file plain-text installer.  Embeds the full
:: Install-AutoNAV.ps1 as base64 lines after the bootstrap.  On run it:
::   1. greps @@AUTONAV@@ lines from itself
::   2. strips the marker
::   3. certutil -decode the base64 to %TEMP%\autonav-setup.ps1
::   4. invokes powershell on it (which self-elevates)
::   5. cleans up
:: Plain-text .cmd -- no SmartScreen / AV warnings.  Double-click to run.
setlocal EnableDelayedExpansion
set "TMPB64=%TEMP%\autonav-setup-%RANDOM%-%RANDOM%.b64"
set "TMPPS1=%TEMP%\autonav-setup-%RANDOM%-%RANDOM%.ps1"
findstr /B "@@AUTONAV@@" "%~f0" > "!TMPB64!.raw"
powershell -NoProfile -Command "(Get-Content '!TMPB64!.raw') | ForEach-Object { $_.Substring(11) } | Set-Content '!TMPB64!'"
del "!TMPB64!.raw" >NUL 2>&1
certutil -decode "!TMPB64!" "!TMPPS1!" >NUL
if errorlevel 1 ( echo ERROR: failed to decode embedded payload. & pause & exit /b 1 )
powershell -NoProfile -ExecutionPolicy Bypass -File "!TMPPS1!"
set "RC=!ERRORLEVEL!"
del "!TMPB64!" >NUL 2>&1
del "!TMPPS1!" >NUL 2>&1
exit /b !RC!
