@echo off
:: AutoNAV-Setup.cmd - single-file installer.  Pure plain-text .cmd -- no AV
:: warning, no extra files needed.  Double-click to run.  The full installer
:: PowerShell script is embedded as base64 lines below; on launch this .cmd:
::   1. greps its own contents for @@AUTONAV@@-prefixed lines
::   2. strips the marker and base64-decodes via certutil
::   3. invokes powershell on the decoded .ps1 (which self-elevates via UAC)
::   4. cleans up the temp files
setlocal EnableDelayedExpansion
set "TMPB64=%TEMP%\autonav-setup-%RANDOM%-%RANDOM%.b64"
set "TMPPS1=%TEMP%\autonav-setup-%RANDOM%-%RANDOM%.ps1"
findstr /B "@@AUTONAV@@" "%~f0" > "!TMPB64!.raw"
powershell -NoProfile -Command "(Get-Content '!TMPB64!.raw') | ForEach-Object { $_.Substring(11) } | Set-Content '!TMPB64!'"
del "!TMPB64!.raw" >NUL 2>&1
certutil -decode "!TMPB64!" "!TMPPS1!" >NUL
if errorlevel 1 (
    echo ERROR: failed to decode embedded payload.
    pause
    exit /b 1
)
powershell -NoProfile -ExecutionPolicy Bypass -File "!TMPPS1!"
set "RC=!ERRORLEVEL!"
del "!TMPB64!" >NUL 2>&1
del "!TMPPS1!" >NUL 2>&1
exit /b !RC!
